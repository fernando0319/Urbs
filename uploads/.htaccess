# Uploads: só arquivos estáticos. Nada aqui é executado.
Options -Indexes -ExecCGI
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  <FilesMatch "\.pdf$">
    Header set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'"
  </FilesMatch>
</IfModule>
